# ── Liaison HOMSLO CONTROL ──────────────────────────────────────────
# Ces valeurs sont FACTICES. Les vraies valeurs se mettent dans les
# variables d'environnement de Vercel, jamais dans le code ni dans Git.

# Adresse complète de la fonction saas_heartbeat de CONTROL
HOMSLO_CONTROL_URL=https://exemple.supabase.co/rest/v1/rpc/saas_heartbeat

# Clé publique de CONTROL
HOMSLO_CONTROL_APIKEY=cle-publique-factice

# Badge de ce SaaS (commence par hsk_)
HOMSLO_CONTROL_BADGE=hsk_badge_factice

# Recommandé : mot de passe que le planificateur doit présenter pour déclencher l'envoi
CRON_SECRET=un-long-mot-de-passe-au-hasard
